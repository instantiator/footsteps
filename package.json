{
  "name": "footsteps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "predev": "bash pre-build.sh",
    "dev": "react-router dev",
    "prebuild": "bash pre-build.sh",
    "build": "tsc -b && react-router build && bash finish-static-build.sh",
    "build:gh-pages": "BASE_URL=${BASE_URL:-/footsteps/} npm run build && BASE_URL=${BASE_URL:-/footsteps/} bash build-docs-site.sh",
    "prelint": "bash pre-build.sh",
    "lint": "eslint .",
    "prepreview": "bash pre-build.sh",
    "preview": "vite preview --outDir dist/client",
    "pretest": "bash pre-build.sh && npm run validate",
    "test": "vitest run",
    "test:run": "bash run-tests.sh",
    "validate": "bash validate-repository.sh public/game-repository.json",
    "lint:check": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mediapipe/tasks-vision": "1.1.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tensorflow-models/body-pix": "2.2.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@uidotdev/usehooks": "^2.4.1",
    "dompurify": "^3.4.17",
    "handlebars": "^4.7.10",
    "isbot": "^5",
    "lodash": "^4.17.21",
    "partycles": "^1.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "ajv": "8.20.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "license-report": "6.8.6",
    "markdownlint-cli": "0.49.1",
    "msw": "^3.0.3",
    "prettier": "^3.6.2",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "typescript-json-schema": "0.68.0",
    "vite": "^8.3.4",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "msw": true,
    "core-js": false,
    "fsevents": false
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "^5.5.0",
      "smol-toml": "^1.9.1",
      "katex": "^0.18.2"
    }
  }
}
