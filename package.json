{
  "name": "footsteps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "predev": "sh pre-build.sh",
    "dev": "react-router dev",
    "prebuild": "sh pre-build.sh",
    "build": "tsc -b && react-router build && sh finish-static-build.sh",
    "build:gh-pages": "BASE_URL=${BASE_URL:-/2025-xmas-game/} npm run build",
    "prelint": "sh pre-build.sh",
    "lint": "eslint .",
    "prepreview": "sh pre-build.sh",
    "preview": "vite preview --outDir dist/client",
    "pretest": "sh pre-build.sh",
    "test": "vitest run",
    "test:run": "sh run-tests.sh",
    "lint:check": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@react-hook/resize-observer": "^2.0.2",
    "@tensorflow-models/body-segmentation": "^1.0.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/lodash": "^4.17.21",
    "@types/mustache": "^4.2.6",
    "@uidotdev/usehooks": "^2.4.1",
    "isbot": "^5",
    "lodash": "^4.17.21",
    "mustache": "^4.2.0",
    "partycles": "^1.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-mustache-template-component": "^2.1.6",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "msw": true,
    "core-js": false,
    "fsevents": false
  }
}
