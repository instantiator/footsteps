<div class="demo-screen demo-sky">
  <div id="balloon-{{state.balloon}}" class="balloon{{#if state.popping}} popping{{/if}}" style="--drop-ms: {{state.dropMs}}ms; left: {{state.left}}%">
    <div class="balloon-sway"><div class="balloon-body"></div></div>
  </div>
  <p id="score" class="demo-score">{{state.score}} / {{data.target}}</p>
</div>
