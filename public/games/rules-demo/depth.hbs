<div class="demo-depth">
  <!-- The room: sky and grass to the horizon, hills beyond low walls, and a chequered floor; one tile lights underfoot -->
  <div class="horizon-background demo-horizon"></div>
  <div class="ground-background demo-ground"></div>
  <div class="rear-background demo-hills"></div>
  <div class="left-background demo-hills"></div>
  <div class="right-background demo-hills"></div>
  <div class="demo-tile" data-floor-area="0 0 25 25"></div>
  <div class="demo-tile demo-tile-dark" data-floor-area="25 0 50 25"></div>
  <div class="demo-tile" data-floor-area="50 0 75 25"></div>
  <div class="demo-tile demo-tile-dark" data-floor-area="75 0 100 25"></div>
  <div class="demo-tile demo-tile-dark" data-floor-area="0 25 25 50"></div>
  <div class="demo-tile" data-floor-area="25 25 50 50"></div>
  <div class="demo-tile demo-tile-dark" data-floor-area="50 25 75 50"></div>
  <div class="demo-tile" data-floor-area="75 25 100 50"></div>
  <div class="demo-tile" data-floor-area="0 50 25 75"></div>
  <div id="depth-tile" class="demo-tile demo-tile-dark{{#if state.tile}} demo-tile-lit{{/if}}" data-floor-area="25 50 50 75"></div>
  <div class="demo-tile" data-floor-area="50 50 75 75"></div>
  <div class="demo-tile demo-tile-dark" data-floor-area="75 50 100 75"></div>
  <div class="demo-tile demo-tile-dark" data-floor-area="0 75 25 100"></div>
  <div class="demo-tile" data-floor-area="25 75 50 100"></div>
  <div class="demo-tile demo-tile-dark" data-floor-area="50 75 75 100"></div>
  <div class="demo-tile" data-floor-area="75 75 100 100"></div>
  <div class="rear-wall demo-wall" data-floor-height="12"></div>
  <div class="left-wall demo-wall" data-floor-height="12"></div>
  <div class="right-wall demo-wall" data-floor-height="12"></div>
  <div id="depth-far" class="demo-depth-item" data-floor-x="20" data-floor-y="30">Far</div>
  <div id="depth-near" class="demo-depth-item{{#if state.lit}} demo-depth-lit{{/if}}" data-floor-x="75" data-floor-y="80" data-floor-thickness="20">Near</div>
  {{#if game.players.[1]}}
  <div id="depth-ring" class="demo-depth-ring" data-floor-x="{{game.players.[1].x}}" data-floor-y="{{game.players.[1].y}}" data-floor-anchor="center"></div>
  {{/if}}
  <p class="demo-depth-hint">Walk around the posts. Stand beside the near one, or on the tile left of it, to light them.</p>
  <p id="depth-position" class="demo-depth-position">
    {{#if game.players.[1]}}Player 1 is at {{game.players.[1].x}} across, {{game.players.[1].y}} forward{{else}}Nobody is on the floor yet{{/if}}
  </p>
  <button id="depth-done" type="button" class="demo-depth-done">Done</button>
</div>
