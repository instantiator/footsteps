<div
  id="horizontal-stepping-stones"
  style="width: 100%; height: 20vh; margin-top: 70vh; display: flex; flex-direction: row; align-items: end; justify-content: space-evenly;">
  {{#gameState.stages}}
  <div id="stepping-stone-stage-{{stage.id}}" style="display: flex; flex-direction: column; align-items: center; justify-content: end;">

    {{#showCompleted}}
    <img src="{{@root.resources.star}}" alt="" style="width: calc( 40vw / {{@root.gameState.totalStages}} ); height: auto;" />
    <img id="stages-link-{{stage.id}}" src="{{@root.resources.stepping-stone}}" alt="Stage {{oneIndex}}: completed" aria-disabled="true" style="width: calc( 75vw / {{@root.gameState.totalStages}} ); height: auto; filter: drop-shadow(0 0 0.75rem green);" />
    {{/showCompleted}}

    {{#showUnlocked}}
    <img id="stages-link-{{stage.id}}" src="{{@root.resources.stepping-stone}}" role="button" tabindex="0" alt="Stage {{oneIndex}}: play" style="width: calc( 75vw / {{@root.gameState.totalStages}} ); height: auto; animation: floatAndZoom 3s ease-in-out infinite alternate; filter: drop-shadow(0 0 0.75rem crimson);" />
    {{/showUnlocked}}

    {{#showLocked}}
    <img id="stages-link-{{stage.id}}" src="{{@root.resources.stepping-stone}}" alt="Stage {{oneIndex}}: locked" aria-disabled="true" style="width: calc( 45vw / {{@root.gameState.totalStages}} ); height: auto; opacity: 0.5;" />
    {{/showLocked}}

    <div style="height: calc( 3vh * {{index}} )"></div>

  </div>
  {{/gameState.stages}}
</div>