<!-- The river scene, drawn in the floor's perspective: the sky at the horizon, meadows to it, the forest beyond the far bank, and the river as the floor -->
<div class="horizon-background" style="background: url('{{resources.river-sky}}') center / 100% 100%;"></div>
<div class="ground-background" style="background: rgb(198, 206, 106);"></div>
<div class="rear-background" style="background: url('{{resources.river-forest}}') bottom / 57% 60% repeat-x;"></div>
<div class="floor-background" style="background: url('{{resources.river-water}}') center / 100% 100%;"></div>
<div class="rear-wall" data-floor-height="10" style="background: url('{{resources.river-bank}}') center / 100% 100%;"></div>
