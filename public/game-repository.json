              },
              {
                "on": {
                  "interact": ["click", "hand-enter", "jump"],
                  "target": "#stages-link-stage-2",
                  "threshold": 0.5
                },
                "do": [{ "enterStage": "stage-2" }]
              },
              {
                "on": {
                  "interact": ["click", "hand-enter", "jump"],
                  "target": "#stages-link-stage-3",
                  "threshold": 0.5
                },
                "do": [{ "enterStage": "stage-3" }]
              },
              {
                "on": {
                  "interact": ["click", "hand-enter", "jump"],
                  "target": "#stages-link-stage-4",
                  "threshold": 0.5
                },
                "do": [{ "enterStage": "stage-4" }]
              },
              {
                "on": {
                  "interact": ["click", "hand-enter", "jump"],
                  "target": "#stages-link-stage-5",
                  "threshold": 0.5
                },
                "do": [{ "enterStage": "stage-5" }]
              },
              {
                "on": {
                  "interact": ["click", "hand-enter", "jump"],
