{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "exclude": ["**/*.css"],
  "tsconfig": "tsconfig.app.json",
  "out": "docs/tsdoc",
  "readme": "none",
  "name": "Footsteps API",
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true,
  "gitRevision": "main"
}
