# App config shared by every environment; see src/config/AppConfig.ts for what each setting means.
# Mode files override this: .env.development (npm run dev), .env.test (vitest), .env.production (npm run build).
# Put personal overrides in an untracked .env.local or .env.[mode].local, and any setting in the URL query
# by its camelCase name, eg. ?debug=true&visionModel=mediapipe. A setting left out uses the code's default.
# No secrets: these files are committed, and every VITE_ value is visible in the built app.

VITE_DEBUG=false
# The camera tracking's frame rate in the HUD
VITE_SHOW_FPS=false

# Vision model: bodypix | mediapipe | movenet
VITE_VISION_MODEL=bodypix
# tfjs backend for bodypix and movenet: webgl | webgpu
VITE_VISION_BACKEND=webgpu
VITE_VISION_WORKER=true
VITE_VISION_MAX_PEOPLE=4
VITE_VISION_SMOOTHING=true
VITE_VISION_STABLE_FRAMES=2
# The widest frame the model is given; wider camera frames are scaled down first (0 = full size)
VITE_VISION_INPUT_WIDTH=960

VITE_CAMERA_WIDTH=1280
VITE_CAMERA_HEIGHT=720
# How far the silhouette's edges fade out, in pixels of the camera canvas (0 = hard edges)
VITE_CAMERA_FEATHER_PX=3
# A player the model loses for a moment is still shown where they were for HOLD ms, then fades over FADE ms, so the
# silhouette doesn't flicker; someone who moves is followed, so leaves no trail. Needs VITE_VISION_SMOOTHING.
VITE_CAMERA_HOLD_MS=400
VITE_CAMERA_FADE_MS=300

# BodyPix: ResNet50 | MobileNetV1; stride 8 | 16 | 32 (ResNet50: 16 | 32, MobileNetV1: 8 | 16); quant bytes 1 | 2 | 4;
# internal resolution low | medium | high | full; threshold 0-1
VITE_BODYPIX_ARCHITECTURE=MobileNetV1
VITE_BODYPIX_OUTPUT_STRIDE=16
VITE_BODYPIX_QUANT_BYTES=2
VITE_BODYPIX_INTERNAL_RESOLUTION=high
VITE_BODYPIX_THRESHOLD=0.65
# Passes to assign pixels to people: fewer is faster with groups
VITE_BODYPIX_REFINE_STEPS=3

# MediaPipe Pose Landmarker: lite | full | heavy
VITE_MEDIAPIPE_VARIANT=full
